# ═══════════════════════════════════════════════════════════════
#  Neo — Frontend Docker (multi-stage)
#  Stage 1 : Build React/Vite avec Node.js
#  Stage 2 : Serve les fichiers statiques avec Nginx (léger)
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# Stage 1 — Build
# ─────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app/frontend

# Copie des fichiers de dépendances en premier (meilleur cache Docker)
COPY frontend/package*.json ./
RUN npm install --silent

# Copie du code source frontend
COPY frontend/ .

# Build de production → sortie dans /app/frontend/dist
RUN npm run build

# ─────────────────────────────────────────────
# Stage 2 — Production (Nginx léger)
# ─────────────────────────────────────────────
FROM nginx:alpine AS production

# Suppression de la page Nginx par défaut
RUN rm -rf /usr/share/nginx/html/*

# Copie des assets buildés depuis le stage builder
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# Copie de la configuration Nginx personnalisée
# (SPA routing + proxy Socket.IO WebSocket + proxy API)
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
